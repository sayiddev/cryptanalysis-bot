# Nusxa oling: cp .env.example .env — va o'z qiymatlaringizni to'ldiring. .env hech qachon commit qilinmaydi.

BOT_TOKEN=000000:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
WEBHOOK_SECRET_TOKEN=change-me-to-a-random-32-byte-hex
WEBHOOK_BASE_URL=https://your-domain.example.com
WEBHOOK_PATH=/webhook

ADMIN_USER_IDS=123456789,987654321

DATABASE_URL=sqlite:///./data/bot.db
REDIS_URL=redis://redis:6379/0

RATE_LIMIT_PER_MINUTE=10
MAX_INPUT_BYTES=65536
JOB_TIMEOUT_SECONDS=20
JOB_MEMORY_LIMIT_MB=256

LOG_LEVEL=INFO
